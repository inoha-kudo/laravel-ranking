{
    "name": "miraiportal/laravel-ranking",
    "version": "1.0.0",
    "license": "MIT",
    "scripts": {
        "test": "phpunit"
    },
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "miraiportal/ranking": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Miraiportal\\LaravelRanking\\": "src/",
            "Miraiportal\\LaravelRanking\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Miraiportal\\LaravelRanking\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Miraiportal\\LaravelRanking\\RankingServiceProvider"
            ]
        }
    }
}
